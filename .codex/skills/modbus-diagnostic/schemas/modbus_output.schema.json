{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModbusDiagnosticOutput",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "bus_type": {
      "type": "string",
      "enum": ["MODBUS_RTU", "MODBUS_TCP"]
    },
    "slave_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 247
    },
    "function_code": {
      "type": "integer"
    },
    "overall_health": {
      "type": "string",
      "enum": ["HEALTHY", "DEGRADED", "BUS_FAULT"]
    },
    "crc_status": {
      "type": "string",
      "enum": ["VALID", "INVALID_CHECKSUM", "ENDIANNESS_ERROR", "NOT_APPLICABLE"]
    },
    "detected_anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "MAJOR", "MINOR"]
          },
          "raw_bytes": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": ["rule_id", "severity", "detail", "action"]
      }
    },
    "telemetry_summary": {
      "type": "object",
      "properties": {
        "requests_sent": { "type": "integer", "minimum": 0 },
        "valid_responses": { "type": "integer", "minimum": 0 },
        "crc_errors": { "type": "integer", "minimum": 0 },
        "timeouts": { "type": "integer", "minimum": 0 },
        "exception_rate_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      },
      "required": ["requests_sent", "valid_responses", "crc_errors", "timeouts"]
    },
    "watchdog_tripped": {
      "type": "boolean"
    }
  },
  "required": [
    "timestamp",
    "bus_type",
    "slave_id",
    "overall_health",
    "crc_status",
    "detected_anomalies",
    "watchdog_tripped"
  ]
}
