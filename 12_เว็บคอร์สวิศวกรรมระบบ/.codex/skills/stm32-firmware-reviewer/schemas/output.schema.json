{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STM32FirmwareReviewOutput",
  "type": "object",
  "properties": {
    "audit_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "file_audited": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": ["PASS", "WARNING_REVIEW_REQUIRED", "CRITICAL_FAIL"]
    },
    "total_defects_found": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_number": {
            "type": "integer"
          },
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "MAJOR", "MINOR"]
          },
          "code_snippet": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "remediation_plan": {
            "type": "string"
          }
        },
        "required": ["line_number", "rule_id", "severity", "description", "remediation_plan"]
      }
    },
    "human_gate_required": {
      "type": "boolean"
    }
  },
  "required": ["audit_timestamp", "file_audited", "overall_status", "total_defects_found", "issues", "human_gate_required"]
}
